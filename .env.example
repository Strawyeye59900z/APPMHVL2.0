# ── Banco de dados ─────────────────────────────────────────
DATABASE_URL=postgresql://condo:condo_pass@postgres:5432/condo

# ── Redis ──────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET=troque_por_segredo_forte_aqui
JWT_REFRESH_SECRET=troque_por_outro_segredo_aqui

# ── Evolution API (WhatsApp) ───────────────────────────────
EVOLUTION_API_URL=http://evolution-api:8080
EVOLUTION_API_KEY=troque_pela_chave_da_evolution
EVOLUTION_INSTANCE=portaria

# ── Google Drive ───────────────────────────────────────────
# Cole o JSON inteiro da Service Account (uma linha, escaped)
GOOGLE_SA_JSON={"type":"service_account","project_id":"..."}
# ID da pasta raiz no Drive onde as subpastas de AP serão criadas
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# ── URLs ───────────────────────────────────────────────────
WEB_URL=https://app.mhvl.com.br
NEXT_PUBLIC_API_URL=http://api:3001
PORT=3001
NODE_ENV=production

# ── Cloudflare Tunnel ──────────────────────────────────────
CF_TUNNEL_TOKEN=token_do_cloudflare_tunnel
