{
  "name": "app-condominio",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "api",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=api\" \"npm run dev --workspace=web\"",
    "build": "npm run build --workspace=shared && npm run build --workspace=api && npm run build --workspace=web",
    "db:migrate": "npm run prisma:migrate --workspace=api",
    "db:seed": "npm run prisma:seed --workspace=api",
    "db:studio": "npm run prisma:studio --workspace=api"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.7.2"
  }
}
